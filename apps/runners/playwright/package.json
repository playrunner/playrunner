{
  "name": "playrunner-playwright-runner",
  "version": "1.0.0",
  "description": "",
  "main": "dist/playwright/src/index.js",
  "scripts": {
    "build": "tsc",
    "lint": "cd .. && playwright/node_modules/.bin/eslint --config playwright/eslint.config.mjs playwright shared",
    "lint:fix": "cd .. && playwright/node_modules/.bin/eslint --config playwright/eslint.config.mjs playwright shared --fix",
    "format": "prettier --config .prettierrc.json --write . ../shared",
    "format:check": "prettier --config .prettierrc.json --check . ../shared",
    "test": "node --require ts-node/register --test src/**/*.test.ts"
  },
  "keywords": [],
  "author": "Concept AI PTY LTD",
  "license": "SEE LICENSE IN ../../../LICENSE",
  "type": "commonjs",
  "dependencies": {
    "@google-cloud/storage": "^7.19.0",
    "google-auth-library": "^10.7.0"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.4",
    "@playwright/test": "1.62.1",
    "@types/node": "^25.6.2",
    "eslint": "^9.39.4",
    "eslint-config-prettier": "10.1.8",
    "globals": "^17.6.0",
    "playwright": "1.62.1",
    "prettier": "3.8.4",
    "ts-node": "^10.9.2",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.61.1"
  }
}
