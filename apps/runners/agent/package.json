{
  "name": "playrunner-agent-runner",
  "private": true,
  "version": "1.0.0",
  "main": "dist/agent/src/index.js",
  "type": "commonjs",
  "scripts": {
    "build": "tsc",
    "lint": "cd .. && agent/node_modules/.bin/eslint --config agent/eslint.config.mjs agent shared",
    "lint:fix": "cd .. && agent/node_modules/.bin/eslint --config agent/eslint.config.mjs agent shared --fix",
    "format": "prettier --config .prettierrc.json --write . ../shared",
    "format:check": "prettier --config .prettierrc.json --check . ../shared",
    "typecheck": "tsc --noEmit",
    "test": "node --require ts-node/register --test src/**/*.test.ts"
  },
  "license": "SEE LICENSE IN ../../../LICENSE",
  "dependencies": {
    "@bgotink/playwright-coverage": "0.3.2",
    "@openai/codex": "0.147.0",
    "@playwright/test": "1.62.1",
    "@testing-library/dom": "10.4.1",
    "@testing-library/react": "16.3.0",
    "@testing-library/user-event": "14.6.1",
    "@vitest/coverage-v8": "3.2.7",
    "jsdom": "26.1.0",
    "playwright": "1.62.1",
    "typescript": "6.0.3",
    "vitest": "3.2.7"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.4",
    "@types/node": "^25.6.2",
    "eslint": "^9.39.4",
    "eslint-config-prettier": "10.1.8",
    "globals": "^17.6.0",
    "prettier": "3.8.4",
    "ts-node": "^10.9.2",
    "typescript-eslint": "^8.61.1"
  }
}
