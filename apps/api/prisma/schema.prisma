generator client {
  provider               = "prisma-client"
  output                 = "../src/generated/prisma"
  moduleFormat           = "cjs"
  generatedFileExtension = "cts"
  importFileExtension    = "cts"
}

datasource db {
  provider = "postgresql"
}

model Project {
  id        String          @id
  userId    String
  title     String?
  createdAt DateTime        @default(now())
  updatedAt DateTime        @updatedAt
  workflows Workflow[]
  memories  ProjectMemory[]

  @@index([userId])
}

model Workflow {
  id               String                    @id
  userId           String
  projectId        String?
  title            String?
  nodes            Json?
  connections      Json?
  cloudProvider    String?
  concurrency      Int?
  createdAt        DateTime                  @default(now())
  updatedAt        DateTime                  @updatedAt
  project          Project?                  @relation(fields: [projectId], references: [id], onDelete: SetNull)
  schedules        WorkflowSchedule[]
  teamShares       WorkflowTeamShare[]
  webhookEndpoints WorkflowWebhookEndpoint[]
  ciExecutions     WorkflowCiExecution[]
  memories         ProjectMemory[]

  @@index([userId])
  @@index([projectId])
}

model WorkflowCiExecution {
  id                String   @id @default(cuid())
  workflowId        String
  executionId       String   @unique
  repository        String
  baseSha           String
  headSha           String
  baseRef           String
  headRef           String
  eventType         String
  pullRequestNumber Int?
  status            String   @default("starting")
  failureHttpStatus Int?
  failureMessage    String?
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt
  workflow          Workflow @relation(fields: [workflowId], references: [id], onDelete: Cascade)

  @@unique([workflowId, headSha])
  @@index([workflowId, repository, headRef])
}

model ProjectMemory {
  id                       String    @id @default(cuid())
  ownerUserId              String
  providerId               String    @default("project-memory")
  scopeKind                String
  scopeId                  String
  projectId                String?
  workflowId               String?
  repository               String
  namespace                String
  revision                 Int       @default(1)
  sourceHeadSha            String?
  sourceExecutionId        String
  sourceExecutionCreatedAt DateTime
  state                    Json
  createdAt                DateTime  @default(now())
  updatedAt                DateTime  @updatedAt
  project                  Project?  @relation(fields: [projectId], references: [id], onDelete: Cascade)
  workflow                 Workflow? @relation(fields: [workflowId], references: [id], onDelete: Cascade)

  @@unique([ownerUserId, providerId, scopeKind, scopeId, repository, namespace])
  @@index([ownerUserId, scopeKind, scopeId, repository])
  @@index([projectId])
  @@index([workflowId])
}

model WorkflowWebhookEndpoint {
  id                String   @id @default(cuid())
  userId            String
  workflowId        String
  nodeId            String
  enabled           Boolean  @default(true)
  secretHash        String
  encryptedSecret   String
  encryptionVersion Int
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt
  workflow          Workflow @relation(fields: [workflowId], references: [id], onDelete: Cascade)

  @@unique([workflowId, nodeId])
  @@index([userId])
}

model WorkflowSchedule {
  id              String                    @id @default(cuid())
  userId          String
  workflowId      String
  scheduleNodeId  String
  provider        String
  cron            String
  timezone        String
  enabled         Boolean                   @default(false)
  gcpJobName      String?
  lastTriggerTime DateTime?
  lastError       String?
  createdAt       DateTime                  @default(now())
  updatedAt       DateTime                  @updatedAt
  workflow        Workflow                  @relation(fields: [workflowId], references: [id], onDelete: Cascade)
  triggers        WorkflowScheduleTrigger[]

  @@unique([workflowId, scheduleNodeId])
  @@index([userId])
  @@index([provider])
}

model WorkflowScheduleTrigger {
  id            String           @id @default(cuid())
  scheduleId    String
  scheduledTime DateTime
  executionId   String?
  status        String           @default("started")
  createdAt     DateTime         @default(now())
  schedule      WorkflowSchedule @relation(fields: [scheduleId], references: [id], onDelete: Cascade)

  @@unique([scheduleId, scheduledTime])
  @@index([scheduleId])
}

model WorkflowExecution {
  id              String          @id
  userId          String
  workflowId      String?
  cloudProvider   String
  status          String          @default("running")
  ingestTokenHash String
  createdAt       DateTime        @default(now())
  updatedAt       DateTime        @updatedAt
  startedAt       DateTime        @default(now())
  completedAt     DateTime?
  events          WorkflowEvent[]

  @@index([userId])
  @@index([workflowId])
}

model WorkflowEvent {
  id            BigInt            @id @default(autoincrement())
  executionId   String
  sourceEventId String?           @unique
  userId        String
  workflowId    String?
  nodeId        String?
  type          String
  level         String?
  message       String?
  payload       Json
  occurredAt    DateTime?
  createdAt     DateTime          @default(now())
  execution     WorkflowExecution @relation(fields: [executionId], references: [id], onDelete: Cascade)

  @@index([executionId])
  @@index([userId])
  @@index([workflowId])
}

model ApiToken {
  id                 String          @id @default(cuid())
  userId             String
  name               String
  tokenHash          String          @unique
  displayPrefix      String
  scopes             Json
  allowedWorkflowIds Json?
  createdAt          DateTime        @default(now())
  lastUsedAt         DateTime?
  expiresAt          DateTime?
  revokedAt          DateTime?
  auditEvents        ApiTokenAudit[]

  @@index([userId])
  @@index([userId, revokedAt])
}

model ApiTokenAudit {
  id          BigInt   @id @default(autoincrement())
  apiTokenId  String
  userId      String
  action      String
  workflowId  String?
  executionId String?
  createdAt   DateTime @default(now())
  apiToken    ApiToken @relation(fields: [apiTokenId], references: [id], onDelete: Cascade)

  @@index([apiTokenId, createdAt])
  @@index([userId, createdAt])
}

model Connection {
  id                String   @id @default(cuid())
  userId            String
  kind              String
  provider          String
  config            Json     @default("{}")
  encryptedSecrets  String?
  encryptionVersion Int?
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt

  @@unique([userId, kind, provider])
  @@index([userId])
}

model Environment {
  id                     String                  @id
  userId                 String
  name                   String
  description            String?
  variables              Json
  createdAt              DateTime                @default(now())
  updatedAt              DateTime                @updatedAt
  authenticationProfiles AuthenticationProfile[]

  @@index([userId])
}

model AuthenticationProfile {
  id                    String      @id @default(cuid())
  ownerUserId           String
  name                  String
  environmentId         String
  applicationLabel      String?
  roleLabel             String?
  startUrl              String
  successConditionType  String
  successConditionValue String
  authenticationMethod  String      @default("local_agent")
  status                String      @default("unauthenticated")
  encryptedState        String?
  encryptionVersion     Int?
  authenticatedAt       DateTime?
  expiresAt             DateTime?
  revokedAt             DateTime?
  createdAt             DateTime    @default(now())
  updatedAt             DateTime    @updatedAt
  environment           Environment @relation(fields: [environmentId], references: [id], onDelete: Restrict)

  @@unique([ownerUserId, name])
  @@index([ownerUserId])
  @@index([environmentId])
}

model AuthenticationProfileAudit {
  id          BigInt   @id @default(autoincrement())
  profileId   String
  actorId     String
  action      String
  outcome     String
  sessionId   String?
  executionId String?
  createdAt   DateTime @default(now())

  @@index([profileId, createdAt])
  @@index([actorId, createdAt])
}

model User {
  id           String   @id @default(cuid())
  email        String?  @unique
  username     String   @unique
  passwordHash String   @map("password_hash")
  createdAt    DateTime @default(now()) @map("created_at")
  updatedAt    DateTime @updatedAt @map("updated_at")

  @@map("Users")
}

model Team {
  id              String              @id @default(cuid())
  name            String
  createdByUserId String
  createdAt       DateTime            @default(now())
  updatedAt       DateTime            @updatedAt
  memberships     TeamMembership[]
  invitations     TeamInvitation[]
  workflowShares  WorkflowTeamShare[]

  @@index([createdByUserId])
}

model WorkflowTeamShare {
  id              String   @id @default(cuid())
  workflowId      String
  teamId          String
  permission      String   @default("view_run")
  createdByUserId String
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt
  workflow        Workflow @relation(fields: [workflowId], references: [id], onDelete: Cascade)
  team            Team     @relation(fields: [teamId], references: [id], onDelete: Cascade)

  @@unique([workflowId, teamId])
  @@index([teamId])
  @@index([workflowId])
}

model TeamMembership {
  id              String   @id @default(cuid())
  teamId          String
  userId          String
  email           String?
  normalizedEmail String?
  displayName     String?
  role            String
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt
  team            Team     @relation(fields: [teamId], references: [id], onDelete: Cascade)

  @@unique([teamId, userId])
  @@unique([teamId, normalizedEmail])
  @@index([userId])
}

model TeamInvitation {
  id               String    @id @default(cuid())
  teamId           String
  email            String
  normalizedEmail  String
  tokenHash        String    @unique
  status           String    @default("pending")
  expiresAt        DateTime
  acceptedAt       DateTime?
  acceptedByUserId String?
  revokedAt        DateTime?
  createdByUserId  String
  createdAt        DateTime  @default(now())
  updatedAt        DateTime  @updatedAt
  team             Team      @relation(fields: [teamId], references: [id], onDelete: Cascade)

  @@unique([teamId, normalizedEmail])
  @@index([teamId, status])
}

model EnvironmentSecret {
  id          String   @id @default(cuid())
  userId      String   @map("user_id")
  key         String
  value       String
  description String?
  createdAt   DateTime @default(now()) @map("created_at")
  updatedAt   DateTime @updatedAt @map("updated_at")

  @@unique([userId, key])
  @@index([userId])
  @@map("EnvironmentSecrets")
}
