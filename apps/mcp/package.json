    "eslint": "^9.39.4",
    "eslint-config-prettier": "10.1.8",
    "globals": "^17.6.0",
    "prettier": "3.8.4",
    "tsx": "^4.23.1",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.61.1"
  }
}
