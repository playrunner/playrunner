{
  "name": "playrunner",
  "version": "0.2.2",
  "description": "Run saved Playrunner workflows from CI/CD.",
  "keywords": [
    "playrunner",
    "ci",
    "cd",
    "workflow",
    "cli"
  ],
  "license": "SEE LICENSE IN LICENSE",
  "author": "Concept AI PTY LTD",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/playrunner/playrunner.git",
    "directory": "packages/cli"
  },
  "homepage": "https://playrunner.dev",
  "bugs": {
    "url": "https://github.com/playrunner/playrunner/issues"
  },
  "type": "module",
  "engines": {
    "node": ">=20"
  },
  "bin": {
    "playrunner": "dist/cli.js"
  },
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "default": "./dist/index.js"
    },
    "./authentication-capture": {
      "types": "./dist/authentication-capture.d.ts",
      "import": "./dist/authentication-capture.js",
      "default": "./dist/authentication-capture.js"
    }
  },
  "files": [
    "dist",
    "LICENSE",
    "README.md"
  ],
  "publishConfig": {
    "registry": "https://registry.npmjs.org",
    "access": "public"
  },
  "scripts": {
    "build": "tsc -p tsconfig.build.json && prettier --write dist",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "test": "tsx --test src/*.test.ts",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "playwright": "1.62.1"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.4",
    "@types/node": "^25.6.2",
    "eslint": "^9.39.4",
    "eslint-config-prettier": "10.1.8",
    "globals": "^17.6.0",
    "prettier": "3.8.4",
    "tsx": "^4.23.1",
    "typescript": "~5.8.2",
    "typescript-eslint": "^8.61.1"
  }
}
